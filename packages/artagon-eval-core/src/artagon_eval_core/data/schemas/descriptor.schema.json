{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artagon/harness-eval/descriptor/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "campaign_id",
    "arm_id",
    "task_id",
    "harness",
    "auth_mode",
    "pin_mode",
    "execution_mode",
    "trial_root",
    "workspace_dir",
    "real_binary",
    "expected_binary_sha256",
    "shim_receipt_path",
    "child_execs_path",
    "hook_socket_path",
    "hook_fallback_path",
    "hook_hmac_key_hex"
  ],
  "properties": {
    "schema_version": {"const": "harness-eval-descriptor/v1"},
    "trial_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "arm_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "harness": {"enum": ["claude", "codex", "agy", "copilot", "kimi"]},
    "model": {"type": "string", "minLength": 1},
    "auth_mode": {"enum": ["subscription", "api_key"]},
    "pin_mode": {"enum": ["nix", "host"]},
    "execution_mode": {"enum": ["headless", "ntm", "herdr", "cao"]},
    "trial_root": {"type": "string", "minLength": 1},
    "workspace_dir": {"type": "string", "minLength": 1},
    "real_binary": {"type": "string", "minLength": 1},
    "expected_binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected_binary_size": {"type": "integer", "minimum": 0},
    "expected_binary_mtime_ns": {"type": "integer", "minimum": 0},
    "shim_receipt_path": {"type": "string", "minLength": 1},
    "child_execs_path": {"type": "string", "minLength": 1},
    "secret_api_key_path": {"type": ["string", "null"]},
    "secret_env_path": {"type": ["string", "null"]},
    "api_key_env_name": {"type": ["string", "null"]},
    "extra_argv": {"type": "array", "items": {"type": "string"}},
    "injected_env": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "scrubbed_env_keys": {"type": "array", "items": {"type": "string"}},
    "hook_socket_path": {"type": "string", "minLength": 1},
    "hook_fallback_path": {"type": "string", "minLength": 1},
    "hook_hmac_key_hex": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "otlp_endpoint": {"type": ["string", "null"]},
    "otlp_bearer_token": {"type": ["string", "null"]},
    "copilot_otel_file_path": {"type": ["string", "null"]},
    "hook_stdout_acks": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
